# ============================================================
# 空地联合具身智能研究平台 (Project Prometheus)
# .gitignore — Python / ROS / Gazebo / PX4 / C++ 项目
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
.eggs/
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
*.cover

# Virtual environments
venv/
.venv/
env/
.env/
pythonenv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# === ROS ===
# Build artifacts
build/
devel/
install/
logs/

# Catkin tools
.catkin_tools/
catkin_ws/
*.rosinstall

# ROS logs
*.log
rosout.log

# === Gazebo ===
# Gazebo model cache
.gazebo/
~/.gazebo/

# Gazebo log files
*.gazebo_log

# === PX4 ===
# PX4 build artifacts
Firmware/build/
PX4-Autopilot/build/
px4_sitl/
*.px4

# === C / C++ ===
*.o
*.obj
*.out
*.a
*.la
*.lo
*.dll
*.dylib
*.exe
*.app

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
!/Makefile
!tasks/**/Makefile
# 固件项目的 Makefile 是手写源码，不是 CMake 生成物，必须入库
!src/firmware/**/Makefile

# 固件构建产物 (build/ 已被上面的 ROS 规则覆盖，这里补上散落的镜像文件)
*.elf
*.map

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === OS ===
# Linux
*~

# Windows
Desktop.ini
$RECYCLE.BIN/

# === Environment & Secrets ===
.env
.env.*
# 例外: 带注释的样例必须入库 —— install.sh 拿它生成各机的 .env,
# README §4.5 也引用它。规则本身是对的 (真实 .env 含各机地址与将来的口令),
# 但"按文件名"的忽略规则每次新增子项目都要复查一遍例外 ——
# 与 2026-07-28 固件 Makefile 被裸 `Makefile` 规则吞掉是同一类问题。
!.env.example
!**/.env.example
*.secret
config/secrets.yaml
config/local.yaml

# === Misc ===
*.bak
*.tmp
*.swp
tmp/
temp/

# === Zip / Archives (don't track large binaries) ===
*.zip
*.tar.gz
*.rar
*.7z
!models/**/*.zip

# ── 部署密钥与本地覆盖 (task-12) ──
# 私钥绝不入库。generate-ssh-keys.sh 只在本地 ~/.ssh 下生成，
# 但有人可能手滑把密钥拷进部署目录, 这里做第二道拦截。
*.pem
*_rsa
*_ed25519
id_*
!id_*.pub.example
src/deployment/**/*.key
src/deployment/**/authorized_keys
# 各机实际的网络配置由模板生成, 含 WiFi 口令, 不入库
src/deployment/network/*.nmconnection
!src/deployment/network/*.nmconnection.template
# 离线镜像包 (*.tar.gz 上面的 Archives 段已覆盖)
src/deployment/**/*.tar
