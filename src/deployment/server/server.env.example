# 实验室服务器 systemd 常驻配置。
# install_server.sh 首次安装时会把 AIR_GROUND_REPO 改成实际仓库路径；重复安装不覆盖。

AIR_GROUND_REPO=/path/to/project-prometheus

# 跨校区部署只让服务器侧 ROS 在本机通信。ROS 1 的动态端口不能直接穿过不稳定 WAN。
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=127.0.0.1
AIR_GROUND_ALLOW_REMOTE_ROS=0

# 根分区当前接近满载，ROS 日志固定写到 data2。
ROS_LOG_DIR=/data2/air-ground-server/ros-log

# 健康检查只探测回环监听。远端通过 VPN / SSH 隧道进入，不直接开放 9090。
AIR_GROUND_HEALTH_HOST=127.0.0.1
AIR_GROUND_HEALTH_PORT=9090
