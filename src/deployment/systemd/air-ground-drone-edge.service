# =============================================================================
# air-ground-drone-edge.service — 无人机边缘节点开机自启
#
# 与车机单元的差异只有一处: **对飞控设备的依赖处理**。
#
# -----------------------------------------------------------------------------
# 为什么不用 `Requires=dev-ttyACM0.device` (task-12 §12.3 原文写法)
# -----------------------------------------------------------------------------
# 两个问题:
#
# 1. **设备名会漂移。** ttyACM 的编号按枚举顺序分配。无人机 Pi 上同时插了
#    USB 转串口调试器时, Pixhawk 可能落到 ttyACM1, 于是这条依赖永远等不到,
#    单元静默停在 inactive —— 在场地上排查这个会非常费时间。
#    生产连接是 40 针排针 UART (/dev/ttyAMA0) 到 TELEM2；台架 USB 才使用
#    udev 的 /dev/pixhawk。实际宿主路径由 DRONE_FCU_DEVICE 选择。
#
# 2. **`Requires=` 对设备单元是硬阻塞。** 飞控没插 = 边缘节点完全不启动,
#    连相机、数传、遥测上报都没有。但这些在飞控没接时仍然有用
#    (地面调试传感器、检查链路)。故障范围不该被启动依赖放大。
#
# 因此改成: `Wants=` 软依赖 + ExecStartPre 里显式等待并**大声失败**。
# 等待超时会在 journal 里留下一条说明该查什么的日志, 而不是一片安静。
#
# 若确实需要"没有飞控就绝不启动"的严格语义 (例如自动起飞流程),
# 把下面 Wants= 改成 BindsTo= 即可 —— udev 规则里的 SYSTEMD_ALIAS 已经
# 把 dev-pixhawk.device 这个单元名准备好了。
# =============================================================================

[Unit]
Description=Air-Ground Drone Edge Node (ROS Noetic, containerized)
Documentation=https://github.com/vista777-nk/Project_Prometheus-research_competition
Documentation=file:///opt/air-ground/README.md
After=network-online.target docker.service chrony.service
Wants=network-online.target chrony.service
Requires=docker.service

Conflicts=air-ground-car-edge.service

# 重启风暴限流。**必须放在 [Unit] 段** —— systemd v230 起
# StartLimitIntervalSec= / StartLimitBurst= 从 [Service] 移到了 [Unit]。
# 旧名 StartLimitInterval= 保留了 [Service] 兼容别名, 新名没有。
# 写错段的表现是 systemd 打一句 "Unknown key name ... ignoring" 然后**静默忽略**:
# 单元照常工作, 但限流根本没生效 —— 配置错了就是无休止的 10 秒重启循环。
# (这一条是 CI 的 systemd-analyze verify 抓出来的, 本机 Windows 跳过了该检查。)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=airground
Group=airground
WorkingDirectory=/opt/air-ground

EnvironmentFile=/opt/air-ground/.env
Environment="COMPOSE_PROJECT_NAME=air-ground"

ExecStartPre=/opt/air-ground/scripts/require-image.sh
# 最多等 30 秒让飞控枚举完。超时不中止启动, 只在 journal 里留证据 ——
# 见脚本内的 --warn-only 说明。
ExecStartPre=/opt/air-ground/scripts/wait-for-device.sh --warn-only --timeout 30 ${DRONE_FCU_DEVICE}

ExecStart=/usr/bin/docker compose \
    -f /opt/air-ground/docker/docker-compose.edge.yml \
    -f /opt/air-ground/docker/docker-compose.drone.yml \
    up --abort-on-container-exit --no-build

ExecStop=/usr/bin/docker compose \
    -f /opt/air-ground/docker/docker-compose.edge.yml \
    -f /opt/air-ground/docker/docker-compose.drone.yml \
    down --timeout 30

Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=60


# --- 加固 (作用范围同车机单元, 见该文件头第 2 条) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/air-ground /var/log/air-ground

StandardOutput=journal
StandardError=journal
SyslogIdentifier=air-ground-drone

[Install]
WantedBy=multi-user.target
