<?xml version="1.0"?>
<package format="2">
  <name>air_ground_drone_bringup</name>
  <version>0.1.0</version>
  <description>PX4 SITL, sensor, and edge-node bringup for the aerial robot.</description>

  <maintainer email="user@example.com">Project Prometheus Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>air_ground_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nodelet</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>topic_tools</depend>

  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rosparam</exec_depend>
  <exec_depend>rostopic</exec_depend>
  <exec_depend>xvfb</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export/>
</package>
