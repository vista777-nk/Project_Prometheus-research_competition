<?xml version="1.0"?>
<!--
  car_edge_real.launch — Task-14 实机模式车机边缘节点

  与 car_edge.launch 的区别: 那份只起 car_preprocessor (数据来自 Gazebo 插件),
  这份额外起 4 个实机传感器驱动, 由它们发布 Layer 1 原始话题。

  backend:=mock (默认) — 假数据后端。验证节点能起、参数能读、话题能建、
                          断流重连能走到; **不产生任何真实读数**。
  backend:=real         — 真实硬件后端, Phase 1 未实现, 节点会立刻抛异常退出。
                          这是刻意的: 一个"能跑但读不到硬件"的空实现,
                          会让实机上安静地发布全零数据 (ADR-0008 那类假绿灯)。

  用法:
    roslaunch air_ground_car_bringup car_edge_real.launch
    roslaunch air_ground_car_bringup car_edge_real.launch backend:=real
-->
<launch>
  <arg name="backend" default="mock"/>
  <arg name="default_chassis" default="diff"/>
  <arg name="sensor_config"
       default="$(find air_ground_car_bringup)/config/real_sensors.yaml"/>
  <arg name="edge_config"
       default="$(find air_ground_car_bringup)/config/car_edge.yaml"/>

  <node name="rplidar_driver"
        pkg="air_ground_car_bringup"
        type="rplidar_driver.py"
        output="screen">
    <rosparam command="load" file="$(arg sensor_config)"/>
    <param name="backend" value="$(arg backend)"/>
  </node>

  <node name="icm42688_driver"
        pkg="air_ground_car_bringup"
        type="icm42688_driver.py"
        output="screen">
    <rosparam command="load" file="$(arg sensor_config)"/>
    <param name="backend" value="$(arg backend)"/>
  </node>

  <node name="hcsr04_driver"
        pkg="air_ground_car_bringup"
        type="hcsr04_driver.py"
        output="screen">
    <rosparam command="load" file="$(arg sensor_config)"/>
    <param name="backend" value="$(arg backend)"/>
  </node>

  <node name="openmv_bridge"
        pkg="air_ground_car_bringup"
        type="openmv_bridge.py"
        output="screen">
    <rosparam command="load" file="$(arg sensor_config)"/>
    <param name="backend" value="$(arg backend)"/>
  </node>

  <!-- 边缘预处理器与仿真模式用的是同一个节点、同一份配置:
       换成实机传感器时它一行不改, 这是 HardwareInterface 分层的目的。 -->
  <node name="car_preprocessor"
        pkg="air_ground_car_bringup"
        type="car_preprocessor.py"
        output="screen">
    <rosparam command="load" file="$(arg edge_config)"/>
    <param name="default_chassis" value="$(arg default_chassis)"/>
  </node>
</launch>
