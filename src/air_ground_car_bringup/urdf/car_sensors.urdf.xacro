<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="car_sensor_suite" params="base_link mount_link">
    <!-- Two-axis OpenMV gimbal. -->
    <link name="gimbal_pan_link">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.000008" ixy="0" ixz="0"
                 iyy="0.000008" iyz="0" izz="0.000012"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.018" length="0.020"/>
        </geometry>
        <material name="car_black"/>
      </visual>
    </link>
    <joint name="gimbal_pan_joint" type="revolute">
      <parent link="${mount_link}"/>
      <child link="gimbal_pan_link"/>
      <origin xyz="0.05 0 0.025" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi / 2.0}" upper="${pi / 2.0}"
             effort="0.5" velocity="3.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <link name="gimbal_tilt_link">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000004" ixy="0" ixz="0"
                 iyy="0.000006" iyz="0" izz="0.000006"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.030 0.025 0.020"/>
        </geometry>
        <material name="car_gray"/>
      </visual>
    </link>
    <joint name="gimbal_tilt_joint" type="revolute">
      <parent link="gimbal_pan_link"/>
      <child link="gimbal_tilt_link"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-pi / 4.0}" upper="${pi / 4.0}"
             effort="0.3" velocity="2.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <link name="openmv_camera_link">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000004" ixy="0" ixz="0"
                 iyy="0.000004" iyz="0" izz="0.000006"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.035 0.035 0.015"/>
        </geometry>
        <material name="car_black"/>
      </visual>
    </link>
    <joint name="openmv_camera_joint" type="fixed">
      <parent link="gimbal_tilt_link"/>
      <child link="openmv_camera_link"/>
      <origin xyz="0.030 0 0" rpy="0 0 0"/>
    </joint>

    <link name="openmv_camera_optical_link"/>
    <joint name="openmv_camera_optical_joint" type="fixed">
      <parent link="openmv_camera_link"/>
      <child link="openmv_camera_optical_link"/>
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>

    <transmission name="gimbal_pan_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gimbal_pan_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="gimbal_pan_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="gimbal_tilt_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gimbal_tilt_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="gimbal_tilt_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <link name="lidar_link">
      <inertial>
        <mass value="0.17"/>
        <inertia ixx="0.000115" ixy="0" ixz="0"
                 iyy="0.000115" iyz="0" izz="0.000213"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.04"/>
        </geometry>
        <material name="car_black"/>
      </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${mount_link}"/>
      <child link="lidar_link"/>
      <origin xyz="-0.05 0 0.055" rpy="0 0 0"/>
    </joint>

    <xacro:macro name="ultrasonic_mount" params="name x y yaw">
      <link name="ultrasonic_${name}_link">
        <inertial>
          <mass value="0.005"/>
          <inertia ixx="0.000001" ixy="0" ixz="0"
                   iyy="0.000001" iyz="0" izz="0.000001"/>
        </inertial>
        <visual>
          <geometry>
            <box size="0.012 0.025 0.016"/>
          </geometry>
          <material name="car_black"/>
        </visual>
      </link>
      <joint name="ultrasonic_${name}_joint" type="fixed">
        <parent link="${base_link}"/>
        <child link="ultrasonic_${name}_link"/>
        <origin xyz="${x} ${y} 0.073" rpy="0 0 ${yaw}"/>
      </joint>
    </xacro:macro>

    <xacro:ultrasonic_mount name="front" x="0.126" y="0" yaw="0"/>
    <xacro:ultrasonic_mount name="rear" x="-0.126" y="0" yaw="${pi}"/>
    <xacro:ultrasonic_mount name="left" x="0" y="0.101" yaw="${pi / 2.0}"/>
    <xacro:ultrasonic_mount name="right" x="0" y="-0.101" yaw="${-pi / 2.0}"/>

    <link name="imu_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.020 0.015 0.005"/>
        </geometry>
        <material name="car_black"/>
      </visual>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="${mount_link}"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
    </joint>

    <gazebo reference="gimbal_pan_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="gimbal_tilt_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="openmv_camera_link">
      <material>Gazebo/Black</material>
      <sensor name="openmv_camera" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10.0</update_rate>
        <camera>
          <horizontal_fov>1.134464</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="openmv_camera_plugin"
                filename="libgazebo_ros_camera.so">
          <robotNamespace>/car</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>openmv</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>openmv_camera_optical_link</frameName>
          <hackBaseline>0.0</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
      <material>Gazebo/Black</material>
      <sensor name="lidar_2d" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10.0</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_laser.so">
          <robotNamespace>/car</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <topicName>scan</topicName>
          <frameName>lidar_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>

    <xacro:macro name="ultrasonic_plugin" params="name">
      <gazebo reference="ultrasonic_${name}_link">
        <material>Gazebo/Black</material>
        <sensor name="ultrasonic_${name}" type="ray">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>25.0</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.02</min>
              <max>4.0</max>
              <resolution>0.003</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.003</stddev>
            </noise>
          </ray>
          <plugin name="ultrasonic_${name}_plugin"
                  filename="libgazebo_ros_laser.so">
            <robotNamespace>/car</robotNamespace>
            <alwaysOn>true</alwaysOn>
            <updateRate>0.0</updateRate>
            <topicName>ultrasonic/${name}</topicName>
            <frameName>ultrasonic_${name}_link</frameName>
            <gaussianNoise>0.0</gaussianNoise>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:macro>

    <xacro:ultrasonic_plugin name="front"/>
    <xacro:ultrasonic_plugin name="rear"/>
    <xacro:ultrasonic_plugin name="left"/>
    <xacro:ultrasonic_plugin name="right"/>

    <gazebo reference="imu_link">
      <material>Gazebo/Black</material>
      <sensor name="car_imu" type="imu">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30.0</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0005</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0005</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0005</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.001</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name="car_imu_plugin"
                filename="libgazebo_ros_imu_sensor.so">
          <robotNamespace>/car</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <topicName>imu/data</topicName>
          <bodyName>imu_link</bodyName>
          <frameName>imu_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
