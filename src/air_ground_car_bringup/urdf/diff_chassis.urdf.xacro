<?xml version="1.0"?>
<robot name="diff_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include
    filename="$(find air_ground_car_bringup)/urdf/car_base.urdf.xacro"/>

  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.18"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="caster_radius" value="0.012"/>
  <xacro:property name="caster_mass" value="0.01"/>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          iyz="0"
          izz="${wheel_mass * wheel_radius * wheel_radius / 2.0}"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="car_black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_radius}" rpy="${-pi / 2.0} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="5.0" velocity="35.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <transmission name="${side}_wheel_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${side}_wheel_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${side}_wheel_motor">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${side}_wheel">
      <material>Gazebo/Black</material>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000</kp>
      <kd>10</kd>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="ball_caster" params="name x">
    <link name="${name}_caster">
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia
          ixx="${0.4 * caster_mass * caster_radius * caster_radius}"
          ixy="0"
          ixz="0"
          iyy="${0.4 * caster_mass * caster_radius * caster_radius}"
          iyz="0"
          izz="${0.4 * caster_mass * caster_radius * caster_radius}"/>
      </inertial>
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="car_gray"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_radius}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}_caster">
      <material>Gazebo/Grey</material>
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000</kp>
      <kd>10</kd>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2.0}"/>
  <xacro:ball_caster name="front" x="0.105"/>
  <xacro:ball_caster name="rear" x="-0.105"/>
</robot>
