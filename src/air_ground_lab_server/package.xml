<?xml version="1.0"?>
<package format="2">
  <name>air_ground_lab_server</name>
  <version>0.1.0</version>
  <description>Hardware-independent World Model, EQA, SLAM, and coordination nodes.</description>

  <maintainer email="1687305011@qq.com">Project Prometheus Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>air_ground_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <exec_depend>air_ground_com_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rosservice</exec_depend>
  <exec_depend>rostopic</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>sensor_msgs</test_depend>

  <export/>
</package>
